# Copy this file to .env, then replace all values with the settings from
# IBM watsonx.ai Developer Access. Never commit backend/.env.
WATSONX_API_KEY=replace-with-ibm-cloud-api-key
WATSONX_PROJECT_ID=replace-with-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=replace-with-a-chat-capable-model-id
